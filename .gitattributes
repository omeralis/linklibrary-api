* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Deployment helpers execute on Linux; preserve exact reviewed bytes.
deploy/** text eol=lf
.github/workflows/*.yml text eol=lf
