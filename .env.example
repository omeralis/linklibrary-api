# ---------------------------------------------------------------------------
# Application / branding (the final brand name is not decided — keep configurable)
# ---------------------------------------------------------------------------
APP_NAME=LinkLibrary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BRAND_NAME="${APP_NAME}"
BRAND_SUPPORT_EMAIL=support@example.com
BRAND_PRIVACY_URL=
BRAND_AI_DISCLOSURE_URL=

# Next.js frontend (used for e-mail links, CORS and Sanctum stateful domains)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional shared secret for Next.js server-side requests (X-Frontend-Key); keep it out of the browser.
FRONTEND_SERVER_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# Set to "deprecations" to collect PHP deprecations in storage/logs/deprecations.log
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=linklibrary
DB_USERNAME=postgres
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions / cookies (Sanctum SPA authentication)
# For production: SESSION_SECURE_COOKIE=true, SESSION_DOMAIN=.your-domain.tld
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# ---------------------------------------------------------------------------
# Cache / queue / Redis  (use redis in production; database works out of the box)
# ---------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
UPLOADS_DISK=public
UPLOADS_MAX_IMAGE_KB=2048

# ---------------------------------------------------------------------------
# Mail (Mailpit in docker-compose: host=mailpit port=1025)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${BRAND_NAME}"

# ---------------------------------------------------------------------------
# Safe fetching (SSRF protection)
# ---------------------------------------------------------------------------
LINK_FETCH_USER_AGENT="LinkLibraryBot/1.0 (+https://example.com/bot)"
LINK_FETCH_ROBOTS_AGENT=LinkLibraryBot
LINK_FETCH_CONNECT_TIMEOUT=5
LINK_FETCH_TIMEOUT=15
LINK_FETCH_MAX_REDIRECTS=5
LINK_FETCH_MAX_BYTES=2097152
LINK_FETCH_ALLOWED_PORTS=80,443,8080,8443
LINK_FETCH_RESPECT_ROBOTS=true
LINK_FETCH_BLOCKED_HOSTS=
# Optional egress proxy. If set, the proxy MUST enforce its own SSRF policy (IP pinning is bypassed).
LINK_FETCH_PROXY=

# ---------------------------------------------------------------------------
# URL reputation (threat intelligence). "heuristic" alone can never mark a URL CLEAR.
# Without an authoritative provider every URL stays UNKNOWN (private only).
# ---------------------------------------------------------------------------
SECURITY_PROVIDERS=heuristic
SECURITY_CLEAR_TTL_DAYS=7
SECURITY_FETCH_WHEN_UNKNOWN=true
SECURITY_BLOCKLIST_HOSTS=
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_WEB_RISK_API_KEY=

# ---------------------------------------------------------------------------
# Metadata extraction
# ---------------------------------------------------------------------------
EXTRACTION_STALE_AFTER_DAYS=30
GITHUB_API_TOKEN=
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# AI (optional). AI_PROVIDER=null disables AI; everything else keeps working.
# ---------------------------------------------------------------------------
AI_PROVIDER=null
AI_TIMEOUT=30
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_REQUEST_LIMIT=1000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions

# ---------------------------------------------------------------------------
# Sharing / discovery
# ---------------------------------------------------------------------------
INVITATION_TTL_HOURS=168
DISCOVERY_CACHE_TTL=60

# ---------------------------------------------------------------------------
# Production hardening
# ---------------------------------------------------------------------------
# Comma separated load-balancer IPs/CIDRs (or *) so HTTPS and client IPs are detected correctly.
TRUSTED_PROXIES=
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
