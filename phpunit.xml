<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="linklibrary_test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="AI_PROVIDER" value="null"/>
        <env name="SECURITY_PROVIDERS" value="heuristic"/>
        <!-- Strict baseline; deployment flags in .env/.env.example must never leak into tests. Tests that need the temporary
             policy call useSecurityPolicy() explicitly. Not forced, so CI can re-run the whole suite with the flags on. -->
        <env name="SECURITY_SCANNING_COMING_SOON" value="false"/>
        <env name="SECURITY_ALLOW_UNVERIFIED_SHARING" value="false"/>
        <env name="FRONTEND_URL" value="http://localhost:3000"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000"/>
        <env name="LOG_DEPRECATIONS_CHANNEL" value="deprecations"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
